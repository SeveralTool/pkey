{
  "name": "pkey",
  "main": "expo/AppEntry",
  "version": "1.0.31",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.3.0 <=22.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prestart": "node scripts/check-node-for-metro.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "test": "jest --config jest.config.js --watchAll",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:core": "npm run build -w @pkey/core",
    "build:web": "npm run build -w @pkey/web-client",
    "embed:pwa": "node scripts/embed-pwa.mjs",
    "refresh:pwa": "npm run build:web && npm run embed:pwa",
    "generate:import-fixtures": "npx tsx scripts/generate-import-fixtures.ts",
    "prebuild:mobile": "npm run build:core && npm run build:web && npm run embed:pwa",
    "stamp:integrity": "npx tsx scripts/stampBuildIntegrity.ts",
    "check:16kb": "node scripts/check-16kb-page-size.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "dev:web": "npm run dev -w @pkey/web-client",
    "test:core": "npm run test -w @pkey/core",
    "test:web": "npm run test -w @pkey/web-client",
    "test:e2e": "npm run test:e2e -w @pkey/web-client",
    "test:e2e:reconnect": "npm run test:e2e:reconnect -w @pkey/web-client",
    "perf": "npm run test:core -- --run && npx jest --config jest.config.js --watchAll=false --testPathPattern=\"(useDebounce|useCardAnalysis|importIcons|storage.perf)\"",
    "validate:otp": "npx tsx scripts/validate-otp.ts",
    "docs:validate": "node scripts/validate-docs.mjs",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@4.0.0 --ignore-npm-errors --output-file sbom.cdx.json",
    "legal:notices": "node scripts/generate-third-party-notices.mjs",
    "legal:site": "node scripts/build-legal-site.mjs",
    "sync:public": "node scripts/sync-public-snapshot.mjs",
    "bootstrap:public-github": "node scripts/bootstrap-public-github.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "check:core-purity": "node -e \"const{execSync}=require('child_process');try{execSync('grep -rE react-native|expo- packages/core/src',{stdio:'pipe'});process.exit(1)}catch{process.exit(0)}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pkey/core": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@shopify/flash-list": "2.0.2",
    "aes-js": "^3.1.2",
    "babel-preset-expo": "~56.0.0",
    "buffer": "^6.0.3",
    "crypto-es": "^3.1.3",
    "expo": "~56.0.21",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.26",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-keep-awake": "~56.0.3",
    "expo-local-authentication": "~56.0.5",
    "expo-location": "~56.0.25",
    "expo-notifications": "~56.0.25",
    "expo-screen-capture": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "node-forge": "^1.4.0",
    "node-libs-browser": "^2.2.1",
    "pkey-autofill": "file:./modules/pkey-autofill",
    "pkey-crypto": "file:./modules/pkey-crypto",
    "pkey-vault-keys": "file:./modules/pkey-vault-keys",
    "pkey-web-access": "file:./modules/pkey-web-access",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "^0.21.0",
    "react-native-zeroconf": "^0.14.0",
    "selfsigned": "^5.5.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.2.10",
    "@types/zxcvbn": "^4.4.5",
    "audit-ci": "^7.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "otplib": "^13.4.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket",
          "pkey-web-access"
        ]
      }
    }
  }
}
