# pkey — environment variables
# Copy to `.env` only if you need local overrides.
# The vault runs fully on-device; no cloud API keys are required.

# Android SDK (used by scripts/ensure-android-sdk.mjs and native builds)
# ANDROID_HOME=C:\Users\You\AppData\Local\Android\Sdk
# ANDROID_SDK_ROOT=C:\Users\You\AppData\Local\Android\Sdk

# CI is set automatically by GitHub Actions / Playwright
# CI=true
